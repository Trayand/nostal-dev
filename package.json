{
  "name": "programming-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first offline PWA for programming practice (single user, no backend).",
  "scripts": {
    "assets": "tsx scripts/copy-assets.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "dev": "npm run assets && npm run content:build && next dev",
    "build": "npm run assets && npm run content:build && next build && tsx scripts/gen-sw.ts",
    "preview": "tsx scripts/serve-out.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:build": "tsx scripts/content-build.ts",
    "content:review": "tsx scripts/content-review.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "idb": "8.0.4",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.1",
    "sucrase": "3.35.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "fake-indexeddb": "6.2.6",
    "marked": "18.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
